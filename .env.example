NODE_ENV=development
PORT=5000

# Database
DIRECT_DATABASE_URL=postgresql://appstore:appstore_password@localhost:5432/appstore_db
DATABASE_URL=prisma+postgresql://appstore:appstore_password@localhost:5432/appstore_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT & OAuth
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRATION=3600
OAUTH_TOKEN_LIFETIME=14400

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
MAX_FILE_SIZE=104857600

# Frontend
FRONTEND_URL=http://localhost:3000

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@example.com
SMTP_PASSWORD=password
SMTP_FROM=noreply@appstore.local

# Observability
LOG_LEVEL=debug
SENTRY_DSN=

# Feature Flags
ENABLE_ADMIN_API=true
ENABLE_ANALYTICS=true
ENABLE_BILLING=true
